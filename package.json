{
	"name": "viewkey-watch",
	"version": "0.1.0",
	"description": "Watch a Monero/Zcash view key and get HMAC-signed webhooks when funds land — no full node, no spend keys. Includes credit metering and XMR/ZEC top-up detection.",
	"type": "module",
	"license": "MIT",
	"main": "./src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"test": "node --experimental-vm-modules node_modules/.bin/jest",
		"test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
	},
	"dependencies": {
		"better-sqlite3": "^12.10.0"
	},
	"devDependencies": {
		"@jest/globals": "^30.1.2",
		"jest": "^30.1.3"
	},
	"keywords": [
		"monero",
		"zcash",
		"view-key",
		"viewing-key",
		"ufvk",
		"orchard",
		"webhook",
		"payment-notification",
		"crypto-payments",
		"privacy",
		"wallet-scanner",
		"incoming-payments"
	]
}
